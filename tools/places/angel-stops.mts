/**
 * Roaming angel stops (gtasf-y5vc item 8): for hacker houses, labs, VCs and accelerators in places.json, find a
 * sidewalk spot in front of the building with the worker's road snapper (LocalRoads) over the full baked city road
 * graph (tools/map/out/sf/roadgraph.bin): the nearest lane point, then ~6 m from the lane toward the building. Written as world metres to
 * shared/content/angelStops.ts so the client (NPC placement) and the server (pitch reach) use identical spots.
 *   tools/map/node_modules/.bin/tsx tools/places/angel-stops.mts
 */
import { readFile, writeFile } from 'node:fs/promises';
import { LocalRoads } from '../../worker/src/world/localRoads';
import { project } from '../../worker/src/funding/anchors';
import { decodePackedRoadGraph, unpackRoadGraph } from '../../shared/roadgraphPacked';

const SNAP_M = 60, KERB_M = 6;
const places = (JSON.parse(await readFile('web/public/data/places.json', 'utf8')) as { places: { id: string; name: string; kind: string; lat: number; lon: number }[] }).places;
// The full city graph from the map bake (the worker's bundled graph only covers the spawn area).
const roads = new LocalRoads(unpackRoadGraph(decodePackedRoadGraph(await readFile(process.env.ROAD_GRAPH ?? 'tools/map/out/sf/roadgraph.bin')))), stops: { placeId: string; name: string; x: number; z: number }[] = [];
for (const p of places.filter(p => ['hackerhouse', 'lab', 'vc', 'accelerator'].includes(p.kind))) {
  const at = project(p.lat, p.lon), snap = roads.snap({ x: at.x * 100, y: 0, z: at.z * 100 }, SNAP_M);
  if (!snap) continue;
  const [rx, , rz] = snap.point, dx = at.x - rx, dz = at.z - rz, d = Math.hypot(dx, dz) || 1, step = Math.min(KERB_M, Math.max(0, d - 2));
  stops.push({ placeId: p.id, name: p.name, x: +(rx + dx / d * step).toFixed(1), z: +(rz + dz / d * step).toFixed(1) });
}
await writeFile('shared/content/angelStops.ts', `// Generated by tools/places/angel-stops.mts from web/public/data/places.json + the worker road graph. Do not edit.\n` +
  `/** Sidewalk spots (world metres, +x east, -z north) in front of SF tech places where roaming angels stand. */\n` +
  `export const ANGEL_STOPS: readonly { placeId: string; name: string; x: number; z: number }[] = ${JSON.stringify(stops)};\n`);
console.log(JSON.stringify({ candidates: places.filter(p => ['hackerhouse', 'lab', 'vc', 'accelerator'].includes(p.kind)).length, stops: stops.length, names: stops.map(s => s.name) }));
