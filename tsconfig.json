{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "web/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
